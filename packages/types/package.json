{
  "name": "@simcoin/types",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical domain types shared across all Simcoin apps and services.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
