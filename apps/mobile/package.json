{
  "name": "@simcoin/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Simcoin mobile client (Expo / React Native) — Phase 2. Shares the SDK and types with apps/web.",
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "^52.0.0",
    "expo-constants": "^17.0.0",
    "expo-status-bar": "^2.0.0",
    "react": "^19.0.0",
    "react-native": "^0.76.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.0.0",
    "@simcoin/sdk": "workspace:*",
    "@simcoin/types": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "babel-preset-expo": "^12.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
