# ─────────────────────────────────────────────────────────────
# Simcoin local environment. Copy to `.env` and fill in values.
# Never commit a real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ---- Postgres (system of record) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=simcoin
POSTGRES_PASSWORD=simcoin
POSTGRES_DB=simcoin
DATABASE_URL=postgresql://simcoin:simcoin@localhost:5432/simcoin

# ---- Redis (cache, pub/sub, leaderboard sorted-sets) ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Better Auth) ----
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:3000

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---- Market data providers (real, live prices) ----
# Used by market-service to ingest BTC/ETH/SOL/ALGO/ICP/DOGE.
MARKET_DATA_PROVIDER=coingecko
COINGECKO_API_KEY=
MARKET_POLL_INTERVAL_MS=1000

# ---- Service ports (local dev) ----
WEB_PORT=3000
ADMIN_PORT=3001
AUTH_SERVICE_PORT=4001
MARKET_SERVICE_PORT=4002
PORTFOLIO_SERVICE_PORT=4003
TRADING_SERVICE_PORT=4004
LEAGUE_SERVICE_PORT=4005
SOCIAL_SERVICE_PORT=4006
NFT_SERVICE_PORT=4007
EDUCATION_SERVICE_PORT=4008
NOTIFICATION_SERVICE_PORT=4009

# ---- Analytics ----
POSTHOG_KEY=
POSTHOG_HOST=https://us.posthog.com
